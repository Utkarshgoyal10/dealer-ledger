PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/shop_ledger
# Use a long random string in production
JWT_SECRET=change-me-to-a-long-random-string
# Comma-separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173
# How many days of data a worker can see without approval
WORKER_VISIBLE_DAYS=30

# Fixed admin login (created automatically on first start)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
ADMIN_NAME=Owner

# Fingerprint login (WebAuthn). In production set these to your real domain, e.g.
# RP_ID=ledger.example.com   RP_ORIGIN=https://ledger.example.com
RP_ID=localhost
RP_ORIGIN=http://localhost:5173
